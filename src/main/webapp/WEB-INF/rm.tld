<?xml version="1.0" encoding="UTF-8"?>
<taglib xmlns="http://java.sun.com/xml/ns/javaee"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-jsptaglibrary_2_1.xsd"
        version="2.1">
  <tlib-version>1.0</tlib-version>
  <short-name>rm</short-name>
  <uri>http://resumematch/functions</uri>
  <function>
    <description>Escapes a value for safe output inside HTML.</description>
    <name>h</name>
    <function-class>com.resumematch.util.HtmlUtil</function-class>
    <function-signature>java.lang.String escape(java.lang.Object)</function-signature>
  </function>
</taglib>
